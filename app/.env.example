# ============================================
# TrackFit - Variables de entorno
# Copia este archivo a app/.env y completa los valores
#   cp .env.example app/.env
# NUNCA subas el archivo .env real al repositorio.
# ============================================

# --- Supabase (backend) ---
# Dashboard de Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# --- Mapas (opcional, solo si usas Google Maps en Android) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Entorno ---
EXPO_PUBLIC_APP_ENV=development

# ============================================
# SECRETOS DEL SERVIDOR (NO van en app/.env)
# Se configuran en Supabase, no en la app movil:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Las variables EXPO_PUBLIC_* quedan expuestas en el bundle
# de la app, por eso la API key de IA vive solo en el servidor.
# ============================================
# ANTHROPIC_API_KEY=
